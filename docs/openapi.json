  "components": {
    "schemas": {
      "Artifact": {
        "properties": {
          "artifact_id": {
            "type": "string",
            "title": "Artifact Id"
          },
          "challenge_id": {
            "type": "string",
            "title": "Challenge Id"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "size": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Size"
          },
          "media_type": {
            "type": "string",
            "title": "Media Type"
          },
          "original_filename": {
            "type": "string",
            "title": "Original Filename"
          },
          "ingested_at": {
            "type": "string",
            "title": "Ingested At"
          },
          "source_event_id": {
            "type": "string",
            "title": "Source Event Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "challenge_id",
          "sha256",
          "size",
          "media_type",
          "original_filename",
          "source_event_id"
        ],
        "title": "Artifact"
      },
      "Body_upload_artifact_api_challenges__cid__artifacts_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_artifact_api_challenges__cid__artifacts_post"
      },
      "Challenge": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "category": {
            "type": "string",
            "enum": [
              "Misc",
              "Crypto",
              "Pwn",
              "Web",
              "Reverse"
            ],
            "title": "Category"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "source": {
            "type": "string",
            "enum": [
              "warmup",
              "practice",
              "competition"
            ],
            "title": "Source",
            "default": "practice"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "challenge_id": {
            "type": "string",
            "title": "Challenge Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "archived"
            ],
            "title": "Status",
            "default": "active"
          },
          "solve_status": {
            "type": "string",
            "enum": [
              "unknown",
              "candidate",
              "verified"
            ],
            "title": "Solve Status",
            "default": "unknown"
          },
          "writeup_status": {
            "type": "string",
            "enum": [
              "not_generated",
              "incomplete",
              "review_required",
              "complete"
            ],
            "title": "Writeup Status",
            "default": "not_generated"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "category"
        ],
        "title": "Challenge"
      },
      "ChallengeCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "category": {
            "type": "string",
            "enum": [
              "Misc",
              "Crypto",
              "Pwn",
              "Web",
              "Reverse"
            ],
            "title": "Category"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "source": {
            "type": "string",
            "enum": [
              "warmup",
              "practice",
              "competition"
            ],
            "title": "Source",
            "default": "practice"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "category"
        ],
        "title": "ChallengeCreate"
      },
      "Event": {
        "properties": {
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "challenge_id": {
            "type": "string",
            "title": "Challenge Id"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Sequence"
          },
          "occurred_at": {
            "type": "string",
            "title": "Occurred At"
          },
          "actor": {
            "type": "string",
            "enum": [
              "user",
              "agent",
              "tool",
              "system"
            ],
            "title": "Actor"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "note",
              "agent_message",
              "hypothesis",
              "plan",
              "tool_proposed",
              "tool_approved",
              "tool_rejected",
              "tool_started",
              "tool_finished",
              "command_started",
              "command_finished",
              "artifact_added",
              "finding",
              "verification",
              "limitation",
              "model_call"
            ],
            "title": "Event Type"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          },
          "artifact_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Artifact Ids"
          },
          "event_refs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Event Refs"
          },
          "previous_event_hash": {
            "type": "string",
            "title": "Previous Event Hash"
          },
          "event_hash": {
            "type": "string",
            "title": "Event Hash",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "challenge_id",
          "sequence",
          "actor",
          "event_type",
          "payload",
          "previous_event_hash"
        ],
        "title": "Event"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NoteCreate": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Text"
          },
          "retrospective": {
            "type": "boolean",
            "title": "Retrospective",
            "default": false
          },
          "correction_of": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correction Of"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "NoteCreate"
      },
      "Scope": {
        "properties": {
          "network_enabled": {
            "type": "boolean",
            "title": "Network Enabled",
            "default": false
          },
          "allowed_targets": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Allowed Targets"
          },
          "profile": {
            "type": "string",
            "const": "XSWCTF",
            "title": "Profile",
            "default": "XSWCTF"
          },
          "max_active_containers": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Max Active Containers",
            "default": 3
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Scope"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
